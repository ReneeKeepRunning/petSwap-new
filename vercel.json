{
  "builds": [
    {
      "src": "frontend/**/*.{js,jsx,ts,tsx,json,html,css,svg,png,jpg,jpeg,gif,ico,webp}",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "backend/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/build/$1"
    }
  ]
}